{
  "name": "msp-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "微服务生态底座 · 无界微前端（主应用壳 + 子应用 + 公共包）",
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:main": "pnpm --filter @platform/main dev",
    "dev:approval": "pnpm --filter @platform/approval-ui dev",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "type-check": "pnpm -r type-check"
  },
  "packageManager": "pnpm@10.30.3"
}
